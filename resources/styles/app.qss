/* === Global === */
QMainWindow {
    background: #f5f6fa;
}

QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 12px;
    color: #2c3e50;
}

/* === Sidebar === */
#sidebar {
    background: #2c3e50;
    border-right: 1px solid #1a252f;
}

#appTitle {
    color: #ecf0f1;
    background: #1a252f;
    padding: 12px;
}

#versionLabel {
    color: #7f8c8d;
    font-size: 10px;
    padding: 2px;
}

#sidebarSeparator {
    background: #34495e;
    border: none;
    margin: 0;
}

#navList {
    background: #2c3e50;
    color: #bdc3c7;
    border: none;
    outline: none;
}

#navList::item {
    padding: 8px 4px;
    border: none;
}

#navList::item:selected {
    background: #3498db;
    color: white;
}

#navList::item:hover:!selected {
    background: #34495e;
    color: #ecf0f1;
}

#userLabel {
    color: #ecf0f1;
    background: #1a252f;
    font-size: 11px;
    padding: 8px;
}

/* === Content Area === */
#contentArea {
    background: #f5f6fa;
}

#placeholderText {
    color: #95a5a6;
    font-size: 16px;
}

/* === Table Widgets === */
QTableWidget {
    background: white;
    border: 1px solid #dcdde1;
    border-radius: 4px;
    gridline-color: #ecf0f1;
    selection-background-color: #3498db;
    selection-color: white;
    alternate-background-color: #f8f9fa;
}

QTableWidget::item {
    padding: 4px 8px;
}

QHeaderView::section {
    background: #2c3e50;
    color: white;
    padding: 6px 8px;
    border: none;
    font-weight: bold;
    font-size: 11px;
}

/* === Buttons === */
QPushButton {
    background: #3498db;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
    min-height: 28px;
}

QPushButton:hover {
    background: #2980b9;
}

QPushButton:pressed {
    background: #2471a3;
}

QPushButton:disabled {
    background: #bdc3c7;
    color: #95a5a6;
}

/* === Input Fields === */
QLineEdit, QDateEdit, QDoubleSpinBox, QSpinBox, QComboBox, QTextEdit {
    border: 1px solid #dcdde1;
    border-radius: 4px;
    padding: 4px 8px;
    background: white;
    min-height: 24px;
}

QLineEdit:focus, QDateEdit:focus, QDoubleSpinBox:focus, QComboBox:focus, QTextEdit:focus {
    border-color: #3498db;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* === Group Box === */
QGroupBox {
    border: 1px solid #dcdde1;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px;
    padding-top: 20px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #2c3e50;
}

/* === Tabs === */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background: #ecf0f1;
    padding: 8px 16px;
    border: 1px solid #dcdde1;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: white;
    border-bottom: 2px solid #3498db;
}

QTabBar::tab:hover:!selected {
    background: #dfe6e9;
}

/* === Labels === */
QLabel {
    color: #2c3e50;
}

/* === Scrollbars === */
QScrollBar:vertical {
    background: #f5f6fa;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #bdc3c7;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #95a5a6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* === Wizard === */
QWizard {
    background: white;
}

QWizardPage {
    background: white;
}

/* === Dialog === */
QDialog {
    background: #f5f6fa;
}
